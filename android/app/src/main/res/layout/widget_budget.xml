<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_budget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_budget" />

        <TextView
            android:id="@+id/budget_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="MONTHLY BUDGET"
            android:textColor="#6C63FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/budget_widget_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹12,450 / ₹25,000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clean Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/budget_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_purple" />

    <!-- Bottom Row with Safe Pacing Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/budget_widget_safe_to_spend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Safe to spend: ₹417 / day"
            android:textColor="#00BFA6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/budget_widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="#9E9EB0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
