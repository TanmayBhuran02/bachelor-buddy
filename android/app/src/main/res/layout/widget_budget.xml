<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_budget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/budget_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BUDGET //"
            android:textColor="#1A1A1A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/budget_widget_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹12.4k / ₹25k"
            android:textColor="#1A1A1A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact Progress Bar (5dp) -->
    <ProgressBar
        android:id="@+id/budget_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_purple" />

    <!-- Bottom Row: Safe Pacing Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/budget_widget_safe_to_spend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Safe: ₹417 / day"
            android:textColor="#2E7D32"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/budget_widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
