<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/todo_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TASKS //"
            android:textColor="#1A1A1A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 TASKS"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Task List Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/todo_widget_item1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="[ ] Buy Groceries"
            android:textColor="#1A1A1A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_widget_item2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="[ ] Pay Electricity Bill"
            android:textColor="#444444"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/todo_widget_item3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="[ ] Confirm Tiffin"
            android:textColor="#666666"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
