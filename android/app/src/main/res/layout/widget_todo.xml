<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <!-- Sticky Note Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_sticky_note_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/todo_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📌 TO-DO"
                android:textColor="#1A1A1A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todo_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 TASKS"
                android:textColor="#713F12"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ruled Divider Line -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="#44CA8A04" />

        <!-- Tasks Container -->
        <LinearLayout
            android:id="@+id/todo_widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/todo_widget_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="All tasks done! ✨\nTap to add new task"
                android:textColor="#854D0E"
                android:textSize="11sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/todo_widget_item1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="◻ Buy Groceries"
                android:textColor="#1A1A1A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todo_widget_item2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="◻ Pay Electricity Bill"
                android:textColor="#1A1A1A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/todo_widget_item3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="◻ Confirm Tiffin"
                android:textColor="#1A1A1A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/todo_widget_item4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1A1A1A"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/todo_widget_item5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1A1A1A"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/todo_widget_item6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1A1A1A"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Masking Tape Pinned on Sticky Note -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="10dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/widget_sticky_tape" />
</FrameLayout>
