<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/todo_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tasks Due Today"
        android:textColor="#FFB74D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/todo_widget_item1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• Buy Groceries for ₹450"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/todo_widget_item2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="• Pay Electricity Bill"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/todo_widget_item3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="• Confirm Tiffin"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
