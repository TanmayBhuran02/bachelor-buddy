<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_water_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/water_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hydration Tracker"
        android:textColor="#00BFA6"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/water_widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1,600 / 2,500 ml"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/water_widget_glasses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="8 of 12 glasses drank"
        android:textColor="#B0BEC5"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_water_add"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="+1 Glass (200ml)"
        android:textSize="12sp" />
</LinearLayout>
