<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_water_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_water" />

        <TextView
            android:id="@+id/water_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="HYDRATION"
            android:textColor="#00BFA6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/water_widget_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1,600 / 2,500 ml"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clean Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/water_widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="64"
        android:progressDrawable="@drawable/widget_progress_teal" />

    <!-- Bottom Row with Status and Minimal +1 Glass Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/water_widget_glasses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8 glasses drank"
            android:textColor="#9E9EB0"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/btn_water_add"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_teal"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_glass_plus"
                android:tint="#161622" />

            <TextView
                android:id="@+id/btn_water_add_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="+1 Glass"
                android:textColor="#161622"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
