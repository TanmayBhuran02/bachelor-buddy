<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tiffin_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tiffin_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Tiffin"
        android:textColor="#9D97FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tiffin_widget_meal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Lunch • Sai Tiffin"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tiffin_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Status: Pending Confirmation"
        android:textColor="#FFB74D"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_tiffin_received"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Received"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_tiffin_skip"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Skip"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
